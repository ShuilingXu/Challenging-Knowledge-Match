# Public hosts covered by the server's wildcard certificate.
APP_DOMAIN=match.soyorin.love
S3_DOMAIN=match-s3.soyorin.love
APP_PORT=4173

POSTGRES_DB=knowledge_match
POSTGRES_USER=match
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password

S3_REGION=us-east-1
S3_BUCKET=matrixlive-media
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=replace-with-the-rustfs-password

# Base64-encoded random bytes, for example: openssl rand -base64 48
JWT_SECRET=replace-with-base64-random-bytes
JWT_ISSUER=knowledge-match
APP_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
